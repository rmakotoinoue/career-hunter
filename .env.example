POSTGRES_DB=careerhunter
POSTGRES_USER=careerhunter
POSTGRES_PASSWORD=change-this-local-password
ASPNETCORE_ENVIRONMENT=Development
WORKER_CYCLE_MINUTES=30

# Shared secret required in the X-Api-Key header on every /api request.
# Leave empty only for a local run: anyone who reaches the port could otherwise read the
# candidate profile and spend the AI credits. The API is published on 127.0.0.1 by default.
API_KEY=

# AI is optional. Leave AI_API_KEY empty to use the deterministic rule engine.
AI_BASE_URL=https://api.openai.com/v1/
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# SMTP is optional. Leave SMTP_HOST empty to use the logging sender locally.
# SMTP_USE_STARTTLS=true requires TLS; set it to false only for a local server without TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Job board APIs. Greenhouse and Lever boards need no credential; Adzuna and Jooble do.
# Adzuna: create a free app at https://developer.adzuna.com and copy the app id/key.
# Jooble: request a key at https://jooble.org/api/about.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# Optional database UI (docker compose --profile tools up -d pgadmin) on http://localhost:5050.
# Loopback only; change the password before exposing it anywhere.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-this-pgadmin-password
